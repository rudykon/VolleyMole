# Keep all local data, annotation records and material manifests out of Git.
/data/

# Upload experiment source scripts only, never reports or generated artifacts.
/experiments/**
!/experiments/stage0/
!/experiments/stage1/
!/experiments/stage0/*.py
!/experiments/stage0/*.sh
!/experiments/stage1/*.py

# Third-party checkouts and weights remain local; preserve required notices.
/tools/*
!/tools/fast-volleyball-tracking-inference/
/tools/fast-volleyball-tracking-inference/*
!/tools/fast-volleyball-tracking-inference/LICENSE
!/tools/basketball-shot-clipper/
