    {"id":"jiujiuwo","label":"救救我救救我","require_all":["emergency_defense"],"require_any":["full_stretch","diving_save","multi_player_scramble"],"forbid":["routine_receive","set"],"placements":["before_action","after_action"],"min_confidence":0.88,"condition":"明显来不及、极限追球、扑救或多人接力抢救。","avoid":"普通垫球、从容接球、二传和真实受伤求助。"},
    {"id":"groundhog_scream","label":"啊（土拨鼠尖叫）","require_all":["sudden_extreme_surprise"],"require_any":["near_miss","absurd_recovery","desperate_dive"],"forbid":["routine_action"],"placements":["after_action"],"min_confidence":0.90,"condition":"突发、夸张且无受伤的险情或离谱救回之后，短促使用。","avoid":"普通球、疼痛、真实受惊或持续尖叫盖住比赛。"},
    {"id":"niubi","label":"牛逼","require_all":["exceptional_skill","successful_outcome"],"require_any":["powerful_spike","difficult_save","solo_block","sustained_rally"],"forbid":["routine_action","failed_outcome","outcome_uncertain"],"placements":["after_action"],"min_confidence":0.92,"condition":"有明确成功结果的高难扣杀、极限救球、单人拦网或连续高质量对抗。","avoid":"普通得分、结果未明和靠对方明显失误得分。"},
    {"id":"refund","label":"***退钱","require_all":["clear_unforced_error","comic_reaction"],"require_any":["missed_easy_ball","serve_into_net","easy_attack_out"],"forbid":["opponent_forced_error","visible_distress"],"placements":["after_action"],"min_confidence":0.92,"condition":"非受迫的明显离谱失误，且有轻松自嘲或同伴友好反应；仅使用已消音版本。","avoid":"正常攻防失误、判罚争议、受伤或针对具体人的辱骂。","requires_censored_asset":true},
