    {"id":"nice","label":"nice","require_all":["successful_outcome","clean_execution"],"require_any":["controlled_save","smart_tip","well_placed_shot","effective_block","good_teamwork"],"forbid":["failed_outcome","outcome_uncertain"],"placements":["after_action"],"min_confidence":0.86,"condition":"干净利落的救球、巧妙吊球、落点处理、拦网或配合成功之后。","avoid":"动作失败、结果不明；不把普通每一球都夸一遍。"},
    {"id":"question_mark","label":"黑人问号","require_all":["visible_confusion","unexpected_event"],"require_any":[],"forbid":["routine_action"],"placements":["after_action"],"min_confidence":0.90,"condition":"画面中确有意外事件和困惑反应，由比赛情节触发；仅音频模式无合适素材时跳过。","avoid":"不能由球员肤色、外貌或身份触发，不能为了贴图增加分屏。"},
